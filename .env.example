# Copy this file to .env on the server and fill in values. Do not commit .env.
POSTGRES_DB=lrt
POSTGRES_USER=lrt
POSTGRES_PASSWORD=replace-with-a-long-unique-password
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
PUBLIC_ORIGIN=https://rating.example.ru
HTTP_PORT=8080
ALLOW_SELF_REGISTRATION=false
# Temporarily open historical reports for UAT edits; turn off after testing.
ALLOW_HISTORICAL_REPORT_EDITING=false

# Required only for explicitly enabled UAT seed commands.
ALLOW_UAT_SEED=false
UAT_PASSWORD=replace-with-a-unique-password-at-least-12-characters
UAT_YEAR=

# Leave empty until Google OAuth and password-reset delivery are configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
PASSWORD_RESET_EMAIL_API_KEY=
PASSWORD_RESET_FROM_EMAIL=
PASSWORD_RESET_EMAIL_API_URL=https://api.resend.com/emails
